                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-e",
                  "x": 236.9,
                  "y": 30.5,
                  "content": "Join our TG",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#2CA5E0",
                  "lineHeight": 1.2
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-f",
                  "x": 330.2,
                  "y": 30.5,
                  "content": "Submit",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "500",
                  "fill": "#000000",
                  "lineHeight": 1.2
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-g",
                  "x": 391.7,
                  "y": 30.5,
                  "content": "Disconnect",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "lineHeight": 1.2
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-h",
                  "x": 16,
                  "y": 105.9,
                  "content": "Privacy Policy for Kiwi News",
                  "fontFamily": "Inter",
                  "fontSize": 26.7,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-i",
                  "x": 16,
                  "y": 154.7,
                  "content": "Last updated: 2025-03-31",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-j",
                  "x": 16,
                  "y": 187.3,
                  "content": "1. Introduction",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-k",
                  "x": 16,
                  "y": 226.9,
                  "content": "This Privacy Policy outlines how Kiwi News collects, uses, and protects your information when you use our service. We are committed to protecting your privacy in compliance with applicable data protection laws, including the General Data Protection Regulation (GDPR).",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 556.1
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-l",
                  "x": 16,
                  "y": 307.5,
                  "content": "2. Data Controller",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-m",
                  "x": 16,
                  "y": 347.1,
                  "content": "Kiwi News is operated by Tim Daubenschütz, who serves as the Data Controller for your personal data.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 556.1
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-n",
                  "x": 16,
                  "y": 392.4,
                  "content": "Contact: tim@daubenschuetz.de",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-o",
                  "x": 16,
                  "y": 425,
                  "content": "3. Information We Collect",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-p",
                  "x": 16,
                  "y": 464.6,
                  "content": "3.1. Analytics Data",
                  "fontFamily": "Inter",
                  "fontSize": 15.6,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-q",
                  "x": 16,
                  "y": 498.2,
                  "content": "We use the following analytics services:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-r",
                  "x": 56,
                  "y": 527.5,
                  "content": "Google Analytics: We collect data such as browsing patterns, device information, and location data to analyze usage and improve our service. For details, seeGoogle's privacy policy.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-s",
                  "x": 56,
                  "y": 575.5,
                  "content": "PostHog: We use PostHog to track user interactions with our platform. For details, seePostHog's privacy policy.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-t",
                  "x": 16,
                  "y": 623.1,
                  "content": "3.2. Blockchain and Web3 Data",
                  "fontFamily": "Inter",
                  "fontSize": 15.6,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-u",
                  "x": 56,
                  "y": 656.7,
                  "content": "Ethereum Addresses: We process wallet addresses to enable blockchain-related features and provide access to certain content.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-v",
                  "x": 56,
                  "y": 688.7,
                  "content": "ENS Data: We retrieve and cache Ethereum Name Service (ENS) data including names, avatars, and profile information.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-w",
                  "x": 56,
                  "y": 720.7,
                  "content": "Farcaster Data: We fetch Farcaster profile information through ENS data integration to enhance user profiles.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-x",
                  "x": 56,
                  "y": 752.7,
                  "content": "Lens Protocol Data: We retrieve Lens Protocol profile data to display in our user interface.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-y",
                  "x": 56,
                  "y": 784.7,
                  "content": "NFT Data: We record NFT minting information through our built-in minting functionality to grant access to features.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-z",
                  "x": 16,
                  "y": 832.3,
                  "content": "3.3. Technical Data",
                  "fontFamily": "Inter",
                  "fontSize": 15.6,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-10",
                  "x": 56,
                  "y": 865.9,
                  "content": "Cookies: We use cookies to store user identity and track update timestamps. These are necessary for the proper functioning of our service.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-11",
                  "x": 56,
                  "y": 897.9,
                  "content": "Local Storage Data: We store authentication information and user preferences in your browser's local storage.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-12",
                  "x": 56,
                  "y": 929.9,
                  "content": "Usage Fingerprinting: We use a privacy-preserving method to count unique interactions with content (such as clicks and impressions). This helps us measure content performance and prevent manipulation of rankings. This method is designed to maintain anonymity—we cannot identify which specific user interacted with which content, and we only store anonymized aggregate statistics.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-13",
                  "x": 16,
                  "y": 1041.5,
                  "content": "3.4. Communication Data",
                  "fontFamily": "Inter",
                  "fontSize": 15.6,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-14",
                  "x": 56,
                  "y": 1075.1,
                  "content": "Transactional Emails: We use Postmark to send transactional emails, such as notifications and account-related messages. Postmark retains email content and metadata for 45 days, after which it is removed from their system. For more information, seePostmark's privacy policy.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-15",
                  "x": 56,
                  "y": 1139.1,
                  "content": "Marketing Emails: If you subscribe to email notifications, we collect your email address. We use Paragraph for managing certain communications. See theirprivacy policyfor details.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-16",
                  "x": 56,
                  "y": 1187.1,
                  "content": "Push Notifications: We store subscription information to send web push notifications if you opt in.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-17",
                  "x": 56,
                  "y": 1219.1,
                  "content": "Telegram Integration: If you choose to connect with Telegram, we process authentication data to generate invitation links.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-18",
                  "x": 16,
                  "y": 1266.7,
                  "content": "3.5. Image Data",
                  "fontFamily": "Inter",
                  "fontSize": 15.6,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-19",
                  "x": 16,
                  "y": 1300.3,
                  "content": "We use Cloudflare Images for image uploads and storage. When you upload images to our platform, they are stored on Cloudflare's infrastructure. See Cloudflare'sprivacy policyfor details.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 557.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1a",
                  "x": 16,
                  "y": 1363.9,
                  "content": "3.6. Mobile App Data",
                  "fontFamily": "Inter",
                  "fontSize": 15.6,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1b",
                  "x": 16,
                  "y": 1397.5,
                  "content": "Our iOS app may collect additional device information required for app functionality. Apple's App Store and TestFlight may collect usage data according toApple's privacy policy.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 557.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1c",
                  "x": 16,
                  "y": 1462.1,
                  "content": "4. Peer-to-Peer Network and Content Distribution",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1d",
                  "x": 16,
                  "y": 1501.7,
                  "content": "Content submitted to our platform is distributed through a peer-to-peer network as cryptographically signed messages. Please be aware that:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 521.4
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1e",
                  "x": 56,
                  "y": 1547,
                  "content": "Content posted on the platform is public by design",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1f",
                  "x": 56,
                  "y": 1563,
                  "content": "Messages are cryptographically signed with your wallet",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1g",
                  "x": 56,
                  "y": 1579,
                  "content": "Content is distributed across a network of nodes",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1h",
                  "x": 56,
                  "y": 1595,
                  "content": "Due to the decentralized nature of the system, complete deletion of this content may not be technically possible",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 503.3
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1i",
                  "x": 16,
                  "y": 1643.6,
                  "content": "5. Legal Basis for Processing",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1j",
                  "x": 16,
                  "y": 1683.2,
                  "content": "We process your data based on the following legal grounds:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1k",
                  "x": 200.4,
                  "y": 1712.5,
                  "content": "Processing necessary to provide you with our service.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1l",
                  "x": 56,
                  "y": 1713.5,
                  "content": "Contract Performance:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1m",
                  "x": 56,
                  "y": 1728.5,
                  "content": "Consent: Where you have given explicit consent, such as for analytics or newsletters.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1n",
                  "x": 56,
                  "y": 1760.5,
                  "content": "Legitimate Interest: Where we have a legitimate interest in processing data to operate, improve and secure our service.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1o",
                  "x": 16,
                  "y": 1809.1,
                  "content": "6. Data Retention",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1p",
                  "x": 16,
                  "y": 1848.7,
                  "content": "We retain different types of data for different periods:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1q",
                  "x": 56,
                  "y": 1878,
                  "content": "P2P Network Content: Messages in our p2p network are potentially available indefinitely due to the distributed nature of the system.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1r",
                  "x": 56,
                  "y": 1910,
                  "content": "Cached Profile Data: ENS, Farcaster, and Lens profile data is cached temporarily to improve performance.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1s",
                  "x": 56,
                  "y": 1942,
                  "content": "Email Data: Transactional emails sent through Postmark are retained for 45 days, after which content and metadata are removed from their system.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1t",
                  "x": 152.3,
                  "y": 1974,
                  "content": "Retained according to our analytics providers' retention policies.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1u",
                  "x": 56,
                  "y": 1975,
                  "content": "Analytics Data:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1v",
                  "x": 56,
                  "y": 1990,
                  "content": "Local Device Data: Stored until you clear your browser storage or uninstall our mobile app.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1w",
                  "x": 16,
                  "y": 2038.6,
                  "content": "7. Data Sharing",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1x",
                  "x": 16,
                  "y": 2078.2,
                  "content": "We use the following service providers who may have access to parts of your data:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1y",
                  "x": 109.3,
                  "y": 2107.5,
                  "content": "Our hosting provider for server infrastructure.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-1z",
                  "x": 56,
                  "y": 2108.5,
                  "content": "Hetzner:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-20",
                  "x": 254.7,
                  "y": 2123.5,
                  "content": "For analytics processing.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-21",
                  "x": 56,
                  "y": 2124.5,
                  "content": "Google Analytics and PostHog:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-22",
                  "x": 126.3,
                  "y": 2139.5,
                  "content": "For content delivery network (CDN) services and image hosting.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-23",
                  "x": 56,
                  "y": 2140.5,
                  "content": "Cloudflare:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-24",
                  "x": 121.2,
                  "y": 2155.5,
                  "content": "For sending transactional emails.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-25",
                  "x": 56,
                  "y": 2156.5,
                  "content": "Postmark:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-26",
                  "x": 126.4,
                  "y": 2171.5,
                  "content": "For certain email communications.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-27",
                  "x": 56,
                  "y": 2172.5,
                  "content": "Paragraph:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-28",
                  "x": 97.5,
                  "y": 2187.5,
                  "content": "For iOS app distribution and TestFlight beta testing.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-29",
                  "x": 56,
                  "y": 2188.5,
                  "content": "Apple:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2a",
                  "x": 16,
                  "y": 2220.1,
                  "content": "8. International Data Transfers",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2b",
                  "x": 16,
                  "y": 2259.7,
                  "content": "Some of our service providers may process your data outside the European Economic Area (EEA). When you use our service, you acknowledge that your information may be transferred to and processed in countries where data protection laws may differ from those in your country of residence.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 544.4
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2c",
                  "x": 16,
                  "y": 2340.3,
                  "content": "9. Your Rights Under GDPR",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2d",
                  "x": 16,
                  "y": 2379.9,
                  "content": "Under the GDPR, you have rights including:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2e",
                  "x": 56,
                  "y": 2409.2,
                  "content": "The right to access your personal data",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2f",
                  "x": 56,
                  "y": 2425.2,
                  "content": "The right to rectification of inaccurate data",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2g",
                  "x": 56,
                  "y": 2441.2,
                  "content": "The right to erasure (with limitations regarding content in the p2p network)",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2h",
                  "x": 56,
                  "y": 2457.2,
                  "content": "The right to restrict processing",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2i",
                  "x": 56,
                  "y": 2473.2,
                  "content": "The right to data portability",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2j",
                  "x": 56,
                  "y": 2489.2,
                  "content": "The right to object to processing based on legitimate interest",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2k",
                  "x": 56,
                  "y": 2505.2,
                  "content": "The right to withdraw consent where processing is based on consent",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2l",
                  "x": 16,
                  "y": 2534.6,
                  "content": "To exercise these rights, please contact us at tim@daubenschuetz.de. We will respond to your request within one month as required by GDPR.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 546.1
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2m",
                  "x": 16,
                  "y": 2579.9,
                  "content": "Please note that for content published through our p2p network, complete deletion may not be technically possible due to the decentralized nature of the system.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 551.5
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2n",
                  "x": 16,
                  "y": 2628.5,
                  "content": "10. Data Security",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2o",
                  "x": 16,
                  "y": 2668.1,
                  "content": "We implement appropriate technical and organizational measures to protect your data, including:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 544.5
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2p",
                  "x": 56,
                  "y": 2713.4,
                  "content": "Secure hosting infrastructure",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2q",
                  "x": 56,
                  "y": 2729.4,
                  "content": "Encryption of sensitive data in transit and at rest",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2r",
                  "x": 56,
                  "y": 2745.4,
                  "content": "Regular security reviews and updates",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2s",
                  "x": 56,
                  "y": 2761.4,
                  "content": "Access controls and authentication systems",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2t",
                  "x": 56,
                  "y": 2777.4,
                  "content": "Secure development practices",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2u",
                  "x": 16,
                  "y": 2810,
                  "content": "11. Children's Privacy",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2v",
                  "x": 16,
                  "y": 2849.6,
                  "content": "Our service is not intended for individuals under 16 years of age, and we do not knowingly collect personal data from children.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 500.2
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2w",
                  "x": 16,
                  "y": 2898.2,
                  "content": "12. Changes to This Policy",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2x",
                  "x": 16,
                  "y": 2937.8,
                  "content": "We may update this Privacy Policy periodically. We will notify you of significant changes by posting the new policy on this page with an updated revision date.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 554.9
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2y",
                  "x": 16,
                  "y": 2986.4,
                  "content": "13. Complaints",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-2z",
                  "x": 16,
                  "y": 3026,
                  "content": "If you have concerns about our data practices, please contact us first. You also have the right to lodge a complaint with your local data protection authority.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 556.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-30",
                  "x": 16,
                  "y": 3074.6,
                  "content": "14. Contact Information",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-privacy-policy-31",
                  "x": 16,
                  "y": 3114.2,
                  "content": "For questions or concerns regarding this privacy policy, please contact:\nTim Daubenschütz\nEmail: tim@daubenschuetz.de",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 557.6
                }
              ]
            },
            {
