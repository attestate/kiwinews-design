                      "geometry": "M129.78,32.44c-.38,0-.53.19-.38.53.64,1.58,1.95,2.52,3.31,2.52,1.01,0,1.95-.49,2.67-1.28.64-.71,1.17-.79,1.84-.38l4.32,2.67c.79.49.94,1.13.45,1.84-1.99,2.86-5.19,4.29-9.25,4.29-6.73,0-11.24-4.51-11.24-11.8s4.51-11.8,11.31-11.8,11.31,4.51,11.31,11.8v.3c0,.86-.45,1.32-1.32,1.32h-13.04ZM135.9,29.28c.38,0,.53-.19.38-.53-.64-1.62-2.03-2.59-3.46-2.59s-2.82.98-3.46,2.59c-.15.34,0,.53.38.53h6.16Z",
                      "viewBox": [
                        0,
