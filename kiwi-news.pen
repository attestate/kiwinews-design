color.text-secondary","content":"01 — ABOUT","fontFamily":"$font.mono","fontSize":16,"fontWeight":"normal","letterSpacing":2},{"type":"text","id":"nRT8l","x":120,"y":170,"name":"Kiwi News is Hacker News","fill":"$color.text-primary","textGrowth":"fixed-width","width":1100,"content":"Kiwi News is Hacker News for the onchain internet.","lineHeight":1.1,"fontFamily":"Inter","fontSize":56,"fontWeight":"700","letterSpacing":-1.2},{"type":"text","id":"nGS3P","x":120,"y":340,"name":"Builders, engineers and ","fill":"$color.text-tertiary","textGrowth":"fixed-width","width":900,"content":"Builders, engineers and crypto researchers share links and discuss them. Stories are picked by people, not algorithms. Every vote and comment is signed and stored on an open, peer-to-peer protocol — anyone can run a node.","lineHeight":1.5,"fontFamily":"Inter","fontSize":24,"fontWeight":"normal"},{"type":"text","id":"lJEtt","x":120,"y":640,"name":"MY ROLE","fill":"$color.text-secondary","content":"MY ROLE","fontFamily":"$font.mono","fontSize":14,"fontWeight":"normal","letterSpacing":1.5},{"type":"text","id":"Y58JX5","x":120,"y":680,"name":"UX/UI designer: audit, c","fill":"$color.text-primary","textGrowth":"fixed-width","width":480,"content":"UX/UI designer: audit, concept, interface, design system and prototypes — in close collaboration with founder Tim Daubenschütz.","lineHeight":1.45,"fontFamily":"Inter","fontSize":22,"fontWeight":"normal"},{"type":"text","id":"UqR56","x":680,"y":640,"name":"SCOPE","fill":"$color.text-secondary","content":"SCOPE","fontFamily":"$font.mono","fontSize":14,"fontWeight":"normal","letterSpacing":1.5},{"type":"text","id":"Sk0a2","x":680,"y":680,"name":"Web (desktop & mobile), ","fill":"$color.text-primary","textGrowth":"fixed-width","width":480,"content":"Web (desktop & mobile), native iOS app, weekly email newsletter, communities, brand refresh.","lineHeight":1.45,"fontFamily":"Inter","fontSize":22,"fontWeight":"normal"},{"type":"text","id":"dj8jx","x":1240,"y