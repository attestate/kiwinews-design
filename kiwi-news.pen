frame","id":"n8AWnZ","width":"fill_container","layout":"vertical","gap":12,"children":[{"type":"frame","id":"p6Wg4","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"RkZjY","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"text","id":"s1gEiB","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"No objectionable, abusive, hateful, sexual, violent or illegal content.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]},{"type":"frame","id":"H6NKs","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"MIzcw","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"text","id":"ShhpL","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"No harassment, ad hominem attacks, spam or shilling.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]},{"type":"frame","id":"xfmEW","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"gWyl5","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"text","id":"CXl0N","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"Everything you post is public, signed with your key and shared across Kiwi nodes; it can't be edited.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]},{"type":"frame","id":"GcVyJ","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"R5L3d","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","