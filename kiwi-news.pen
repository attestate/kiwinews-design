ily":"Inter","fontSize":22,"fontWeight":"700"},{"type":"text","id":"ovWt1","name":"Paragraph","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"Kiwi News is a community-curated link aggregator for Ethereum and web3, similar to Hacker News. Links are submitted and liked by developers, researchers, founders and people who spend their days onchain. Every submission and like is a signed, public message.","lineHeight":1.6,"fontFamily":"Inter","fontSize":16,"fontWeight":"normal"},{"type":"text","id":"fJgcV","name":"Paragraph","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"Kiwi News Weekly is the short version. Each Sunday we take the stories that got the most likes, comments and clicks over the past seven days and send you the top five. No algorithmic feed, no paid placements, no price talk for its own sake.","lineHeight":1.6,"fontFamily":"Inter","fontSize":16,"fontWeight":"normal"}]},{"type":"frame","id":"i46t0","name":"Who and what","width":"fill_container","stroke":"$color.separator","strokeWidth":{"top":0.5},"gap":40,"padding":[32,0,0,0],"children":[{"type":"frame","id":"YYd1A","name":"Who it's for","width":"fill_container","layout":"vertical","gap":14,"children":[{"type":"text","id":"Ny934","name":"Heading","fill":"$color.text-primary","content":"Who it's for","fontFamily":"Inter","fontSize":22,"fontWeight":"700"},{"type":"frame","id":"gKDdJ","name":"Item","width":"fill_container","gap":10,"children":[{"type":"frame","id":"i03Nb","name":"Bullet wrapper","padding":[8,0,0,0],"children":[{"type":"rectangle","cornerRadius":1,"id":"sMeJ9","name":"Bullet","fill":"$color.accent-strong","width":6,"height":6}]},{"type":"frame","id":"TeI24","name":"Text","width":"fill_container","layout":"vertical","gap":2,"children":[{"type":"text","id":"UEpmC","name":"Body","fill":"$color.text-secondary","textGrowth":"fixed-width","width":"fill_container","content":"Ethereum and web3 developers who want to