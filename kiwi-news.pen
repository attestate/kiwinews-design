on laws, including the General Data Protection Regulation (GDPR).","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]},{"type":"frame","id":"pwlvV","width":"fill_container","layout":"vertical","gap":12,"children":[{"type":"frame","id":"GDTxx","width":"fill_container","padding":[4,0,0,0],"children":[{"type":"text","id":"r2T7X","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"2. Data Controller","lineHeight":1.2,"fontFamily":"Inter","fontSize":20,"fontWeight":"600"}]},{"type":"text","id":"CdCOO","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"Kiwi News is operated by Tim Daubenschütz, who serves as the Data Controller for your personal data.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"frame","id":"pqcP7","width":"fill_container","children":[{"type":"text","id":"PNw5U","fill":"$color.text-primary","content":"Contact: ","fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"text","id":"T0iDH","fill":"$color.text-primary","content":"tim@daubenschuetz.de","fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]}]},{"type":"frame","id":"FRusR","width":"fill_container","layout":"vertical","gap":12,"children":[{"type":"frame","id":"gCTfD","width":"fill_container","padding":[4,0,0,0],"children":[{"type":"text","id":"SBauH","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"3. Information We Collect","lineHeight":1.2,"fontFamily":"Inter","fontSize":20,"fontWeight":"600"}]}]},{"type":"frame","id":"srgE0","width":"fill_container","layout":"vertical","gap":12,"children":[{"type":"text","id":"LCRh7","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"3.1. Analytics Data","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"600"},{"type":"text","id":"F447kv","fill":"$color.text-primary","textGrowth":"fixed-width","width":"