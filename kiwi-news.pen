                        212.55999755859375,
                        53.41999816894531
                      ],
                      "fill": "#000000"
                    },
                    {
                      "type": "path",
                      "id": "web-desktop-guidelines-7",
                      "x": 0,
                      "y": 0,
                      "width": 99.5,
                      "height": 25,
                      "geometry": "M157.82,20.93c.26-.83.83-1.28,1.69-1.28h4.89c.86,0,1.43.45,1.69,1.28l3.08,10.3c.11.38.19.38.3,0l3.08-10.3c.26-.83.83-1.28,1.69-1.28h4.89c.86,0,1.17.41.9,1.24l-6.54,19.74c-.26.83-.86,1.24-1.73,1.24h-4.89c-.86,0-1.47-.41-1.73-1.24l-3.01-9.1c-.11-.34-.26-.34-.38,0l-3.01,9.1c-.26.83-.86,1.24-1.73,1.24h-4.89c-.86,0-1.47-.41-1.73-1.24l-6.54-19.74c-.26-.83.04-1.24.9-1.24h4.89c.86,0,1.43.45,1.69,1.28l3.08,10.3c.11.38.19.38.3,0l3.08-10.3Z",
                      "viewBox": [
                        0,
