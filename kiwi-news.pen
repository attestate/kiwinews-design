            {
              "type": "text",
              "id": "web-mobile-privacy-policy-i",
              "x": 16,
              "y": 218.3,
              "content": "1. Introduction",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-j",
              "x": 16,
              "y": 257.9,
              "content": "This Privacy Policy outlines how Kiwi News collects, uses, and protects your information when you use our service. We are committed to protecting your privacy in compliance with applicable data protection laws, including the General Data Protection Regulation (GDPR).",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 349.9
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-k",
              "x": 16,
              "y": 370.5,
              "content": "2. Data Controller",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-l",
              "x": 16,
              "y": 410.1,
              "content": "Kiwi News is operated by Tim Daubenschütz, who serves as the Data Controller for your personal data.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 330.2
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-m",
              "x": 16,
              "y": 455.4,
              "content": "Contact: tim@daubenschuetz.de",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-n",
              "x": 16,
              "y": 488,
              "content": "3. Information We Collect",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-o",
              "x": 16,
              "y": 527.6,
              "content": "3.1. Analytics Data",
              "fontFamily": "Inter",
              "fontSize": 15.6,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-p",
              "x": 16,
              "y": 561.2,
              "content": "We use the following analytics services:",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-q",
              "x": 56,
              "y": 590.5,
              "content": "Google Analytics: We collect data such as browsing patterns, device information, and location data to analyze usage and improve our service. For details, seeGoogle's privacy policy.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-r",
              "x": 56,
              "y": 654.5,
              "content": "PostHog: We use PostHog to track user interactions with our platform. For details, seePostHog's privacy policy.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-s",
              "x": 16,
              "y": 718.1,
              "content": "3.2. Blockchain and Web3 Data",
              "fontFamily": "Inter",
              "fontSize": 15.6,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-t",
              "x": 56,
              "y": 751.7,
              "content": "Ethereum Addresses: We process wallet addresses to enable blockchain-related features and provide access to certain content.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-u",
              "x": 56,
              "y": 799.7,
              "content": "ENS Data: We retrieve and cache Ethereum Name Service (ENS) data including names, avatars, and profile information.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-v",
              "x": 56,
              "y": 847.7,
              "content": "Farcaster Data: We fetch Farcaster profile information through ENS data integration to enhance user profiles.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-w",
              "x": 56,
              "y": 895.7,
              "content": "Lens Protocol Data: We retrieve Lens Protocol profile data to display in our user interface.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-x",
              "x": 56,
              "y": 927.7,
              "content": "NFT Data: We record NFT minting information through our built-in minting functionality to grant access to features.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-y",
              "x": 16,
              "y": 991.3,
              "content": "3.3. Technical Data",
              "fontFamily": "Inter",
              "fontSize": 15.6,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-z",
              "x": 56,
              "y": 1024.9,
              "content": "Cookies: We use cookies to store user identity and track update timestamps. These are necessary for the proper functioning of our service.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-10",
              "x": 56,
              "y": 1088.9,
              "content": "Local Storage Data: We store authentication information and user preferences in your browser's local storage.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-11",
              "x": 56,
              "y": 1136.9,
              "content": "Usage Fingerprinting: We use a privacy-preserving method to count unique interactions with content (such as clicks and impressions). This helps us measure content performance and prevent manipulation of rankings. This method is designed to maintain anonymity—we cannot identify which specific user interacted with which content, and we only store anonymized aggregate statistics.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-12",
              "x": 16,
              "y": 1296.5,
              "content": "3.4. Communication Data",
              "fontFamily": "Inter",
              "fontSize": 15.6,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-13",
              "x": 56,
              "y": 1330.1,
              "content": "Transactional Emails: We use Postmark to send transactional emails, such as notifications and account-related messages. Postmark retains email content and metadata for 45 days, after which it is removed from their system. For more information, seePostmark's privacy policy.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-14",
              "x": 56,
              "y": 1426.1,
              "content": "Marketing Emails: If you subscribe to email notifications, we collect your email address. We use Paragraph for managing certain communications. See theirprivacy policyfor details.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-15",
              "x": 56,
              "y": 1506.1,
              "content": "Push Notifications: We store subscription information to send web push notifications if you opt in.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-16",
              "x": 56,
              "y": 1554.1,
              "content": "Telegram Integration: If you choose to connect with Telegram, we process authentication data to generate invitation links.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-17",
              "x": 16,
              "y": 1617.7,
              "content": "3.5. Image Data",
              "fontFamily": "Inter",
              "fontSize": 15.6,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-18",
              "x": 16,
              "y": 1651.3,
              "content": "We use Cloudflare Images for image uploads and storage. When you upload images to our platform, they are stored on Cloudflare's infrastructure. See Cloudflare'sprivacy policyfor details.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 359
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-19",
              "x": 16,
              "y": 1730.9,
              "content": "3.6. Mobile App Data",
              "fontFamily": "Inter",
              "fontSize": 15.6,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1a",
              "x": 16,
              "y": 1764.5,
              "content": "Our iOS app may collect additional device information required for app functionality. Apple's App Store and TestFlight may collect usage data according toApple's privacy policy.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 359
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1b",
              "x": 16,
              "y": 1845.1,
              "content": "4. Peer-to-Peer Network and Content Distribution",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "700",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 348.8
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1c",
              "x": 16,
              "y": 1907.7,
              "content": "Content submitted to our platform is distributed through a peer-to-peer network as cryptographically signed messages. Please be aware that:",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 351.6
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1d",
              "x": 56,
              "y": 1969,
              "content": "Content posted on the platform is public by design",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1e",
              "x": 56,
              "y": 1985,
              "content": "Messages are cryptographically signed with your wallet",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 310.8
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1f",
              "x": 56,
              "y": 2017,
              "content": "Content is distributed across a network of nodes",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1g",
              "x": 56,
              "y": 2033,
              "content": "Due to the decentralized nature of the system, complete deletion of this content may not be technically possible",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 292.5
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1h",
              "x": 16,
              "y": 2097.6,
              "content": "5. Legal Basis for Processing",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1i",
              "x": 16,
              "y": 2137.2,
              "content": "We process your data based on the following legal grounds:",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 318.7
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1j",
              "x": 56,
              "y": 2182.5,
              "content": "Contract Performance: Processing necessary to provide you with our service.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1k",
              "x": 56,
              "y": 2214.5,
              "content": "Consent: Where you have given explicit consent, such as for analytics or newsletters.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1l",
              "x": 56,
              "y": 2246.5,
              "content": "Legitimate Interest: Where we have a legitimate interest in processing data to operate, improve and secure our service.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1m",
              "x": 16,
              "y": 2311.1,
              "content": "6. Data Retention",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1n",
              "x": 16,
              "y": 2350.7,
              "content": "We retain different types of data for different periods:",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1o",
              "x": 56,
              "y": 2380,
              "content": "P2P Network Content: Messages in our p2p network are potentially available indefinitely due to the distributed nature of the system.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1p",
              "x": 56,
              "y": 2428,
              "content": "Cached Profile Data: ENS, Farcaster, and Lens profile data is cached temporarily to improve performance.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1q",
              "x": 56,
              "y": 2476,
              "content": "Email Data: Transactional emails sent through Postmark are retained for 45 days, after which content and metadata are removed from their system.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1r",
              "x": 56,
              "y": 2540,
              "content": "Analytics Data: Retained according to our analytics providers' retention policies.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1s",
              "x": 56,
              "y": 2572,
              "content": "Local Device Data: Stored until you clear your browser storage or uninstall our mobile app.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1t",
              "x": 16,
              "y": 2620.6,
              "content": "7. Data Sharing",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1u",
              "x": 16,
              "y": 2660.2,
              "content": "We use the following service providers who may have access to parts of your data:",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 339.8
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1v",
              "x": 56,
              "y": 2705.5,
              "content": "Hetzner: Our hosting provider for server infrastructure.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1w",
              "x": 56,
              "y": 2737.5,
              "content": "Google Analytics and PostHog: For analytics processing.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1x",
              "x": 56,
              "y": 2769.5,
              "content": "Cloudflare: For content delivery network (CDN) services and image hosting.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1y",
              "x": 56,
              "y": 2801.5,
              "content": "Postmark: For sending transactional emails.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-1z",
              "x": 56,
              "y": 2817.5,
              "content": "Paragraph: For certain email communications.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-20",
              "x": 56,
              "y": 2833.5,
              "content": "Apple: For iOS app distribution and TestFlight beta testing.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 319
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-21",
              "x": 16,
              "y": 2882.1,
              "content": "8. International Data Transfers",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-22",
              "x": 16,
              "y": 2921.7,
              "content": "Some of our service providers may process your data outside the European Economic Area (EEA). When you use our service, you acknowledge that your information may be transferred to and processed in countries where data protection laws may differ from those in your country of residence.",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 354.6
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-23",
              "x": 16,
              "y": 3034.3,
              "content": "9. Your Rights Under GDPR",
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "700",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-24",
              "x": 16,
              "y": 3073.9,
              "content": "Under the GDPR, you have rights including:",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-25",
              "x": 56,
              "y": 3103.2,
              "content": "The right to access your personal data",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-26",
              "x": 56,
              "y": 3119.2,
              "content": "The right to rectification of inaccurate data",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-27",
              "x": 56,
              "y": 3135.2,
              "content": "The right to erasure (with limitations regarding content in the p2p network)",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282",
              "textGrowth": "fixed-width",
              "width": 292
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-28",
              "x": 56,
              "y": 3167.2,
              "content": "The right to restrict processing",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-29",
              "x": 56,
              "y": 3183.2,
              "content": "The right to data portability",
              "fontFamily": "Inter",
              "fontSize": 13.3,
              "fontWeight": "400",
              "fill": "#828282"
            },
            {
              "type": "text",
              "id": "web-mobile-privacy-policy-2a",
              "x": 56,
              "y": 3199.2,
              "content": "The right to object to processing based on legitimate interest",
