                  "type": "text",
                  "id": "fJgcV",
                  "name": "Paragraph",
                  "fill": "$color.text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Kiwi News Weekly is the short version. Each Sunday we take the stories that got the most upvotes, comments and clicks over the past seven days and send you the top five. No algorithmic feed, no paid placements, no price talk for its own sake.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
