                        256,
                        256
                      ],
                      "stroke": "#2CA5E0",
                      "strokeWidth": 0.9,
                      "strokeLinecap": "round",
                      "strokeLinejoin": "round"
                    },
                    {
                      "type": "path",
                      "id": "web-desktop-guidelines-c",
                      "x": 0,
                      "y": 0,
                      "width": 14,
                      "height": 14,
                      "geometry": "M124.37,173.78,93.76,205.54A8,8,0,0,1,80,200V134.87",
                      "viewBox": [
                        0,
                        0,
                        256,
                        256
                      ],
                      "stroke": "#2CA5E0",
                      "strokeWidth": 0.9,
                      "strokeLinecap": "round",
                      "strokeLinejoin": "round"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-e",
                  "x": 236.9,
                  "y": 30.5,
                  "content": "Join our TG",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#2CA5E0",
                  "lineHeight": 1.2
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-f",
                  "x": 330.2,
                  "y": 30.5,
                  "content": "Submit",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "500",
                  "fill": "#000000",
                  "lineHeight": 1.2
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-g",
                  "x": 391.7,
                  "y": 30.5,
                  "content": "Disconnect",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "lineHeight": 1.2
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-h",
                  "x": 16,
                  "y": 105.9,
                  "content": "Why guidelines are important",
                  "fontFamily": "Inter",
                  "fontSize": 26.7,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-i",
                  "x": 16,
                  "y": 154.7,
                  "content": "We have an opportunity to build our own corner of the onchain internet. With awesome people, links, resources, and learning. To ensure this corner is valuable, we need to follow some submission guidelines.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 548.1
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-j",
                  "x": 16,
                  "y": 219.3,
                  "content": "What to submit?",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-k",
                  "x": 16,
                  "y": 258.9,
                  "content": "On topic:",
                  "fontFamily": "Inter",
                  "fontSize": 15.6,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-l",
                  "x": 16,
                  "y": 292.5,
                  "content": "Anything that gratifies the intellectual curiosities of builders, engineers, hackers, and craftspeople in the community.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 533.1
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-m",
                  "x": 16,
                  "y": 337.8,
                  "content": "That includes:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-n",
                  "x": 56,
                  "y": 367.2,
                  "content": "Technical resources, hacking, and awesome git repos",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-o",
                  "x": 56,
                  "y": 383.2,
                  "content": "Dune dashboards, reports, data-driven articles",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-p",
                  "x": 56,
                  "y": 399.2,
                  "content": "Startups, cryptocurrencies, cryptography",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-q",
                  "x": 56,
                  "y": 415.2,
                  "content": "Networking, privacy, decentralization",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-r",
                  "x": 56,
                  "y": 431.2,
                  "content": "Hardware, open source, art, economics, game theory",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-s",
                  "x": 56,
                  "y": 447.2,
                  "content": "Anything else our community might find fascinating, covering any subject from philosophy, literature, and pop culture, through science, and health, up to society and infrastructure",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 511.4
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-t",
                  "x": 16,
                  "y": 510.8,
                  "content": "Off topic:",
                  "fontFamily": "Inter",
                  "fontSize": 15.6,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-u",
                  "x": 56,
                  "y": 544.3,
                  "content": "Sensationalist journalism for the sake of ad revenue (including overly optimized click-bait, rage-bait, fluff headlines, clickthrough optimized headlines, cliffhanger headlines, posts with no substance)",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 512.3
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-v",
                  "x": 56,
                  "y": 592.3,
                  "content": "Mediocre resources",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-w",
                  "x": 56,
                  "y": 608.3,
                  "content": "Old stories we all read and that have been widely shared elsewhere",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-x",
                  "x": 56,
                  "y": 624.3,
                  "content": "Shilling (you know what this means)",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-y",
                  "x": 16,
                  "y": 656.9,
                  "content": "How to submit?",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-z",
                  "x": 16,
                  "y": 696.5,
                  "content": "A good headline tells you exactly what to expect without embellishing or optimizing for clickthrough. Some recommendations:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 545.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-10",
                  "x": 56,
                  "y": 741.9,
                  "content": "No emojis in titles",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-11",
                  "x": 56,
                  "y": 757.9,
                  "content": "Attempt to submit the original title",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-12",
                  "x": 56,
                  "y": 773.9,
                  "content": "Trim the title if it's too long without losing substance",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-13",
                  "x": 56,
                  "y": 789.9,
                  "content": "Avoid Title Casing Because It Looks Like Spam (and it's terrible to read)",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-14",
                  "x": 56,
                  "y": 805.9,
                  "content": "Avoid Upworthy and Buzzfeed style titles along the lines of, \"Fiat Crisis with Balaji (shocking!)\" - there's no need to add the last part",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 513.4
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-15",
                  "x": 56,
                  "y": 837.9,
                  "content": "Consider NOT submitting pay-walled articles",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-16",
                  "x": 56,
                  "y": 853.9,
                  "content": "Don't end a title with a period or dot",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-17",
                  "x": 56,
                  "y": 869.9,
                  "content": "When introducing a new project or concept, you can use either:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-18",
                  "x": 96,
                  "y": 885.9,
                  "content": "A dash (-): \"ETHStrategy - fully onchain Microstrategy for Ethereum\"",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-19",
                  "x": 96,
                  "y": 901.9,
                  "content": "A colon (:): \"Farcaster 2026: The Game-Changing Potential of AI Agents\"",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1a",
                  "x": 56,
                  "y": 917.9,
                  "content": "Don't include the hosting platform in titles (e.g., \"GitHub - bitcoin/bitcoin\") as we already show the domain",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 507
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1b",
                  "x": 16,
                  "y": 965.5,
                  "content": "Open Graph Images",
                  "fontFamily": "Inter",
                  "fontSize": 15.6,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1c",
                  "x": 16,
                  "y": 999,
                  "content": "Open Graph images are a crucial part of the submission. They're not an afterthought - they're often the first thing users see.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 541.7
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1d",
                  "x": 56,
                  "y": 1044.4,
                  "content": "Images should be visually appealing and professionally designed",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1e",
                  "x": 56,
                  "y": 1060.4,
                  "content": "Low-quality, poorly designed, or hastily created images will be moderated",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1f",
                  "x": 56,
                  "y": 1076.4,
                  "content": "The image should meaningfully represent the content",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1g",
                  "x": 16,
                  "y": 1108,
                  "content": "Submitter Requirements",
                  "fontFamily": "Inter",
                  "fontSize": 15.6,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1h",
                  "x": 16,
                  "y": 1141.6,
                  "content": "To maintain quality and accountability in our community, we have specific requirements for story submissions:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 551.5
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1i",
                  "x": 56,
                  "y": 1186.9,
                  "content": "Stories will be removed from the front page if the submitter hasn't connected at least one of:",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 501.3
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1j",
                  "x": 96,
                  "y": 1218.9,
                  "content": "Farcaster account",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1k",
                  "x": 96,
                  "y": 1234.9,
                  "content": "ENS name",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1l",
                  "x": 96,
                  "y": 1250.9,
                  "content": "Lens profile",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1m",
                  "x": 56,
                  "y": 1266.9,
                  "content": "Submissions from accounts showing only a truncated address (e.g., 0xA9D2...1A87) will not appear on the front page",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 427.9
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1n",
                  "x": 16,
                  "y": 1312.2,
                  "content": "Connect your social accounts to ensure your submissions remain visible to the community.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 494.7
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1o",
                  "x": 16,
                  "y": 1360.8,
                  "content": "How to like?",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1p",
                  "x": 16,
                  "y": 1400.4,
                  "content": "Within a small community, liking carries a lot of weight. The recommendation here is to carefully consider what's worth liking and what isn't. Avoid liking things you haven't read, watched, or vetted as worthy of other people's time.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 546.5
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1q",
                  "x": 16,
                  "y": 1461.7,
                  "content": "Thanks to",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1r",
                  "x": 81.9,
                  "y": 1461.7,
                  "content": "thatalexpalmer.eth",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#000000"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1s",
                  "x": 198,
                  "y": 1461.7,
                  "content": "who helped us prepare submission guidelines.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1t",
                  "x": 16,
                  "y": 1495.6,
                  "content": "Commenting guidelines",
                  "fontFamily": "Inter",
                  "fontSize": 26.7,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1u",
                  "x": 16,
                  "y": 1544.5,
                  "content": "Kiwi wants to provide clarity in the confusing crypto world. Comments play a huge role here, as they can expand the idea, add context, or debunk the statements in the articles shared here.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 552.8
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1v",
                  "x": 16,
                  "y": 1605.8,
                  "content": "So just as we specified what content we want to see, now we want to ensure it's clear what kind of comments we are looking for. Also, since comments can't be edited (at least for now) and are fully public, it’s good to give them a bit of thought.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 541.5
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1w",
                  "x": 16,
                  "y": 1670.4,
                  "content": "What comments are we looking for?",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1x",
                  "x": 56,
                  "y": 1711,
                  "content": "Extra Context\nKiwi users see only the headline, so if you are a person who submitted the link, feel free to add more context. Explain what this content is about, why you think it’s interesting, and share if you agree with it or not.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1y",
                  "x": 56,
                  "y": 1791,
                  "content": "Insider's perspective\nIf an essay is about subject X (app, blockchain, or whatever), and you have interacted with it before, feel free to share your perspective. It's always interesting to learn from people who have first-hand experience.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-1z",
                  "x": 56,
                  "y": 1871,
                  "content": "Deeper dive\nIf you can add more context and information about the subject, please do it. We like to get a 360 perspective of the things we discuss.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-20",
                  "x": 56,
                  "y": 1935,
                  "content": "Debunks\nIf the material is misleading or you disagree with it, share your perspective (and, if applicable, sources to support it!)",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-21",
                  "x": 56,
                  "y": 1999,
                  "content": "Impact on you\nIf this essay changed how you look at this particular subject, tell us what you thought before and how you think about it now.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-22",
                  "x": 56,
                  "y": 2063,
                  "content": "Questions\nIf you have any questions related to the subject, feel free to ask them.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-23",
                  "x": 56,
                  "y": 2111,
                  "content": "Funny, spicy remarks\nIf you have a funny, spicy way to comment on the content, feel free to do it.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-24",
                  "x": 16,
                  "y": 2155.3,
                  "content": "This list is non-exhaustive, so all comments that include more context, help us understand the subject better, or add value to the conversation are much welcome!",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 523.8
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-25",
                  "x": 16,
                  "y": 2203.9,
                  "content": "What comments to avoid?",
                  "fontFamily": "Inter",
                  "fontSize": 20,
                  "fontWeight": "700",
                  "fill": "#828282"
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-26",
                  "x": 56,
                  "y": 2244.5,
                  "content": "Ad hominem attacks\nPlease avoid personal attacks against authors and commenters. If you think they are questionable, point to relevant material (see above: Debunks).",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-27",
                  "x": 56,
                  "y": 2308.5,
                  "content": "Shilling and spamming\nWe all know what this means. If you spot a comment you think could be labeled as such, please let us know on the Telegram group.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-28",
                  "x": 56,
                  "y": 2372.5,
                  "content": "Strawman's arguments\nIt’s okay to digress, but if your arguments aren’t related to the discussion, then it’s not that helpful.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-29",
                  "x": 56,
                  "y": 2436.5,
                  "content": "“I made it up” comments\n“Extraordinary claims require extraordinary evidence”. So if you say something that is not a well-known fact, and don’t provide data or arguments to support your point, the comment is not that useful.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 517.6
                },
                {
                  "type": "text",
                  "id": "web-desktop-guidelines-2a",
                  "x": 16,
                  "y": 2512.8,
                  "content": "PS: Thanks to mishaderidder.eth, rvolz.eth, zinkk.eth, and noctis.eth for helping us to set up commenting guidelines.",
                  "fontFamily": "Inter",
                  "fontSize": 13.3,
                  "fontWeight": "400",
                  "fill": "#828282",
                  "textGrowth": "fixed-width",
                  "width": 557.6
                },
                {
