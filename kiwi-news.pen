1300,"content":"Great stories, but few people joined the conversation.","lineHeight":1.1,"fontFamily":"Inter","fontSize":56,"fontWeight":"700","letterSpacing":-1.2},{"type":"rectangle","id":"Q6fp9I","x":120,"y":470,"name":"Rule","fill":"$color.wordmark-green","width":390,"height":3},{"type":"text","id":"safN1","x":120,"y":500,"name":"01","fill":"$color.text-secondary","content":"01","fontFamily":"$font.mono","fontSize":16,"fontWeight":"normal"},{"type":"text","id":"G3n1i","x":120,"y":540,"name":"Engagement","fill":"$color.text-primary","content":"Engagement","fontFamily":"Inter","fontSize":30,"fontWeight":"700"},{"type":"text","id":"UICEg","x":120,"y":600,"name":"Few readers voted or com","fill":"$color.text-tertiary","textGrowth":"fixed-width","width":380,"content":"Few readers voted or commented. The grey up-arrow didn’t read as “I like this”, and every action looked the same.","lineHeight":1.5,"fontFamily":"Inter","fontSize":21,"fontWeight":"normal"},{"type":"rectangle","id":"vzMAb","x":550,"y":470,"name":"Rule","fill":"$color.border","width":390,"height":3},{"type":"text","id":"g1Wmv","x":550,"y":500,"name":"02","fill":"$color.text-secondary","content":"02","fontFamily":"$font.mono","fontSize":16,"fontWeight":"normal"},{"type":"text","id":"o8yiIZ","x":550,"y":540,"name":"Retention","fill":"$color.text-primary","content":"Retention","fontFamily":"Inter","fontSize":30,"fontWeight":"700"},{"type":"text","id":"O4R6n","x":550,"y":600,"name":"Activity was dropping. N","fill":"$color.text-tertiary","textGrowth":"fixed-width","width":380,"content":"Activity was dropping. Nothing brought readers back once a week, and there was no reading list to return to.","lineHeight":1.5,"fontFamily":"Inter","fontSize":21,"fontWeight":"normal"},{"type":"rectangle","id":"Kyy8f","x":980,"y":470,"name":"Rule","fill":"$color.border","width":390,"height":3},{"type":"text","id":"vLgiZ","x":980,"y":500,"name":"03","fill":"$color.text-secondary","content":"03","fontFamily":"$font.mono","fontSize":16,"fontWeight":"normal"},{"type":"text","id":"XCUR4","x":980,"y":540,"name":"Onboarding","fill":"$color.text-primary","content":"Onboarding","fontFamily":"Inter","fontSize":30,"fontWeight":"700"},{"type":"text","id":"Vk7uA","x":980,"y":600,"name":"Joining meant connecting","fill":"$color.text-tertiary","textGrowth":"fixed-width","width":380,"content":"Joining meant connecting a crypto wallet first. Most curious readers stopped right there.","lineHeight":1.5,"fontFamily":"Inter","fontSize":21,"fontWeight":"normal"},{"type":"rectangle","id":"FrA5G","x":1410,"y":470,"name":"Rule","fill":"$color.border","width":390,"height":3},{"type":"text","id":"rr4qe","x":1410,"y":500,"name":"04","fill":"$color.text-secondary","content":"04","fontFamily":"$font.mono","fontSize":16,"fontWeight":"normal"},{"type":"text","id":"eOFAz","x":1410,"y":540,"name":"Growth","fill":"$color.text-primary","content":"Growth","fontFamily":"Inter","fontSize":30,"fontWeight":"700"},{"type":"text","id":"JGSW9","x":1410,"y":600,"name":"Everything lived in one ","fill":"$color.text-tertiary","textGrowth":"fixed-width","width":380,"content":"Everything lived in one feed. Smaller groups — like people building with AI — had no place of their own.","lineHeight":1.5,"fontFamily":"Inter","fontSize":21,"fontWeight":"normal"},{"type":"frame","id":"Voi50","x":120,"y":880,"name":"Constraint","width":1680,"fill":"$color.comment-strip","cornerRadius":14,"gap":16,"padding":[22,28],"alignItems":"center","children":[{"type":"text","id":"ocbrU","name":"Label","fill":"$color.text-secondary","content":"CONSTRAINT","fontFamily":"$font.mono","fontSize":14,"fontWeight":"normal","letterSpacing":1.5},{"type":"text","id":"YYbZr","name":"Text","fill":"$color.text-primary","content":"Keep the fast, text-first, slightly nerdy character the community loves. No dark patterns, no algorithmic feed.","fontFamily":"Inter","fontSize":22,"fontWeight":"500"}]}]},{"type":"frame","id":"R5coJ","x":20000,"y":22400,"name":"Behance 05 · St