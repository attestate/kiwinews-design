                  "name": "Paragraph",
                  "fill": "$color.text-primary",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Kiwi News is a community-curated link aggregator for Ethereum and web3, similar to Hacker News. Links are submitted and upvoted by developers, researchers, founders and people who spend their days onchain. Every submission and upvote is a signed, public message.",
                  "lineHeight": 1.6,
                  "fontFamily": "Inter",
                  "fontSize": 16,
                  "fontWeight": "normal"
                },
