frame","id":"o7jVa","name":"Legende","gap":6,"alignItems":"center","children":[{"type":"rectangle","cornerRadius":3,"id":"OQ7aZ","name":"Farbe","fill":"$color.wordmark-green","width":12,"height":12},{"type":"text","id":"pMZT3","name":"Balken verbindet sich · ","fill":"$color.text-secondary","content":"Balken verbindet sich · 0–450 ms","fontFamily":"Inter","fontSize":12,"fontWeight":"normal"}]},{"type":"frame","id":"jodjl","name":"Legende","gap":6,"alignItems":"center","children":[{"type":"rectangle","cornerRadius":3,"id":"yhh8J","name":"Farbe","fill":"$color.segment-track","width":12,"height":12},{"type":"text","id":"b1brS","name":"Maskottchen springt dazu","fill":"$color.text-secondary","content":"Halten · 450–850 ms","fontFamily":"Inter","fontSize":12,"fontWeight":"normal"}]},{"type":"frame","id":"Ife93","name":"Legende","gap":6,"alignItems":"center","children":[{"type":"rectangle","cornerRadius":3,"id":"INZMd","name":"Farbe","fill":"$color.kiwi-green-light","width":12,"height":12},{"type":"text","id":"WdwOd","name":"Überblenden · 850–1000 m","fill":"$color.text-secondary","content":"Überblenden · 850–1000 ms","fontFamily":"Inter","fontSize":12,"fontWeight":"normal"}]}]},{"type":"frame","id":"fRj2S","name":"Spezifikation","width":"fill_container","gap":24,"children":[{"type":"frame","id":"D7XXt","name":"Spec · Bewegung","width":"fill_container","layout":"vertical","gap":6,"children":[{"type":"text","id":"DyvR1","name":"Bewegung","fill":"$color.text-primary","content":"Bewegung","fontFamily":"Inter","fontSize":15,"fontWeight":"600"},{"type":"text","id":"hhP9P","name":"Text","fill":"$color.text-tertiary","textGrowth":"fixed-width","width":"fill_container","content":"Nur der Balken bewegt sich: Die zwei Punkte wachsen in 450 ms (ease-in-out) aufeinander zu. Die Schrift bleibt ruhig. Kein Maskottchen — die Figur hat ihren Auftritt im Onboarding.","lineHeight":1.45,"fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"qFyZU","name":"Spec · Technik (iOS)","width":"fill_container","layout":"vertical","gap":6,"children":[{"type":"text","id":"dEziX","name":"Technik (iOS)","fill":"$color.text-primary","content":"Technik (iOS)","fontFamily":"Inter","fontSize":15,"fontWeight":"600"},{"type":"text","id":"xPObr","name":"Text","fill":"$color.text-tertiary","textGrowth":"fixed-width","width":"fill_container","content":"Der iOS-Launch-Screen ist immer statisch. Er zeigt deshalb Schritt 1: nur die Wortmarke mit zwei Punkten. Die Animation läuft im ersten App-Screen, der exakt gleich aussieht.","lineHeight":1.45,"fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"H6mEn","name":"Spec · Wann","width":"fill_container","layout":"vertical","gap":6,"children":[{"type":"text","id":"XSVL4","name":"Wann","fill":"$color.text-primary","content":"Wann","fontFamily":"Inter","fontSize":15,"fontWeight":"600"},{"type":"text","id":"H8Zkvq","name":"Text","fill":"$color.text-tertiary","textGrowth":"fixed-width","width":"fill_container","content":"Nur beim Kaltstart, nie beim Zurückkehren in die App. Insgesamt ca. 1 Sekunde. Sind die Stories früher geladen, wird die Animation nicht künstlich verlängert.","lineHeight":1.45,"fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]},{"type":"frame","id":"j0F9y","name":"Spec · Barrierefreiheit","width":"fill_container","layout":"vertical","gap":6,"children":[{"type":"text","id":"d9hG3","name":"Barrierefreiheit","fill":"$color.text-primary","content":"Barrierefreiheit","fontFamily":"Inter","fontSize":15,"fontWeight":"600"},{"type":"text","id":"Q7r9t","name":"Text","fill":"$color.text-tertiary","textGrowth":"fixed-width","width":"fill_container","content":"Bei „Bewegung reduzieren“: Der Balken erscheint direkt, nur sanftes Überblenden. Hell und Dunkel folgen dem System.","lineHeight":1.45,"fontFamily":"Inter","fontSize":13,"fontWeight":"normal"}]}]}]},{"type":"frame","id":"czMxK","x":-7049,"y":-1700,"name":"Splash · iOS · Launch-Screen (statisch, Start der Anim