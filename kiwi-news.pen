                        212.55999755859375,
                        53.41999816894531
                      ],
                      "fill": "#000000"
                    },
                    {
                      "type": "path",
                      "id": "web-desktop-guidelines-7",
                      "x": 0,
                      "y": 0,
                      "width": 99.5,
                      "height": 25,
                      "geometry": "M157.82,20.93c.26-.83.83-1.28,1.69-1.28h4.89c.86,0,1.43.45,1.69,1.28l3.08,10.3c.11.38.19.38.3,0l3.08-10.3c.26-.83.83-1.28,1.69-1.28h4.89c.86,0,1.17.41.9,1.24l-6.54,19.74c-.26.83-.86,1.24-1.73,1.24h-4.89c-.86,0-1.47-.41-1.73-1.24l-3.01-9.1c-.11-.34-.26-.34-.38,0l-3.01,9.1c-.26.83-.86,1.24-1.73,1.24h-4.89c-.86,0-1.47-.41-1.73-1.24l-6.54-19.74c-.26-.83.04-1.24.9-1.24h4.89c.86,0,1.43.45,1.69,1.28l3.08,10.3c.11.38.19.38.3,0l3.08-10.3Z",
                      "viewBox": [
                        0,
                        0,
                        212.55999755859375,
                        53.41999816894531
                      ],
                      "fill": "#000000"
                    },
                    {
                      "type": "path",
                      "id": "web-desktop-guidelines-8",
                      "x": 0,
                      "y": 0,
                      "width": 99.5,
                      "height": 25,
                      "geometry": "M194.95,28.34c-1.5,0-1.16-2.14-4.28-2.14-2.26,0-2.67.71-2.67,1.5,0,2.29,13.19-.94,13.19,8.53,0,3.16-3.2,6.39-10.9,6.39-8.23,0-10.19-3.98-10.49-7.97-.07-.86.38-1.32,1.28-1.32h5.11c1.28,0,.34,2.14,4.1,2.14,2.26,0,3.2-.71,3.2-1.5,0-1.92-13.19.56-13.19-8.53,0-2.78,1.92-6.43,10.37-6.43,6.73,0,9.44,3.08,9.81,8.01.08.86-.38,1.32-1.28,1.32h-4.25Z",
                      "viewBox": [
                        0,
                        0,
                        212.55999755859375,
                        53.41999816894531
                      ],
                      "fill": "#000000"
                    }
                  ]
                },
                {
                  "type": "frame",
                  "id": "web-desktop-guidelines-d",
                  "name": "icon",
                  "layout": "none",
                  "x": 218.9,
                  "y": 31.5,
                  "width": 14,
                  "height": 14,
                  "children": [
                    {
                      "type": "path",
                      "id": "web-desktop-guidelines-a",
                      "x": 0,
                      "y": 0,
                      "width": 14,
                      "height": 14,
                      "geometry": "M80,134.87,170.26,214a8,8,0,0,0,13.09-4.21L224,33.22a1,1,0,0,0-1.34-1.15L20,111.38A6.23,6.23,0,0,0,21,123.3Z",
                      "viewBox": [
                        0,
                        0,
                        256,
                        256
                      ],
                      "stroke": "#2CA5E0",
                      "strokeWidth": 0.9,
                      "strokeLinecap": "round",
                      "strokeLinejoin": "round"
                    },
                    {
                      "type": "path",
                      "id": "web-desktop-guidelines-b",
                      "x": 0,
                      "y": 0,
                      "width": 14,
                      "height": 14,
                      "geometry": "M80 134.87 L223.41 32.09",
                      "viewBox": [
                        0,
