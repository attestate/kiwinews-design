idth":"fill_container","layout":"vertical","gap":12,"children":[{"type":"frame","id":"l1OTiV","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"j8pjD7","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"text","id":"Zl2hY","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"No objectionable, abusive, hateful, sexual, violent or illegal content.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]},{"type":"frame","id":"N2pUi","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"M9eUT","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"text","id":"v8zCy","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"No harassment, ad hominem attacks, spam or shilling.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]},{"type":"frame","id":"V9Ku9","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"GGdGq","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"text","id":"tMqvS","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"Everything you post is public, signed with your key and shared across Kiwi nodes; it can’t be edited.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]},{"type":"frame","id":"cv1Ho","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"G2k3d","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeig