"text","id":"LBQ76","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"No objectionable, abusive, hateful, sexual, violent or illegal content.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]},{"type":"frame","id":"SYyZX","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"LCO9p","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"text","id":"Z3HvH","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"No harassment, ad hominem attacks, spam or shilling.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]},{"type":"frame","id":"HA3EX","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"VoL1y","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"text","id":"d9M7zc","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"Everything you post is public, signed with your key and shared across Kiwi nodes; it can't be edited.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"}]},{"type":"frame","id":"NjUIO","name":"doc-bullet","width":"fill_container","gap":8,"children":[{"type":"text","id":"Bk4AA","fill":"$color.text-secondary","textGrowth":"fixed-width","width":14,"content":"•","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"normal"},{"type":"text","id":"ByAUi","fill":"$color.text-primary","textGrowth":"fixed-width","width":"fill_container","content":"Report posts, comments and people from their \"…\" menu, or block them. We review reports within 24 hours and remove violating content and accounts.","lineHeight":1.45,"fontFamily":"Inter","fontSize":17,"fontWeight":"nor